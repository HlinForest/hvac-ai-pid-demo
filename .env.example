# Set these environment variables before running the live LLM experiment.
# This project does not read .env automatically.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=YOUR_TOOL_CAPABLE_MODEL
DASHSCOPE_API_KEY=YOUR_API_KEY

# DeepSeek example: use --key-env DEEPSEEK_API_KEY --reasoning-effort none
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# DEEPSEEK_API_KEY=YOUR_API_KEY
