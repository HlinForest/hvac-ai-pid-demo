# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Local OpenModelica runtime and temporary artifact-tool workspaces
modelica_runtime/
tmp/
tmp_submission/

# Generated inspection payloads: the actual Excel/PPT deliverables are retained.
outputs/**/*.inspect.ndjson
outputs_embedded_demo/*.inspect.ndjson

# Render-time KaTeX derivatives (copied from vendor/katex by hvac_pid/report.py).
**/report_assets/

# Regenerable pipeline scratch (default `python main.py --output outputs`).
# Sealed history lives in outputs_review_v3/; new runs go to artifacts/runs/.
# OpenModelica C build intermediates; retain the response CSV used by validation.
outputs_review_v3/modelica/*
!outputs_review_v3/modelica/PrecisionCabinetCooling_res.csv

# Rendered slide previews duplicate the actual PowerPoint deliverable.
outputs_review_v3/submission_package/slides_preview_v2/
outputs_review_v3/submission_package/slides_rendered/

# Local document QA renders and audit JSON; final DOCX files remain tracked.
outputs_review_v3/docx_qa/
outputs_review_v3/documents/*_a11y.json

# Native testbench binaries are rebuilt from the supplied C++ source.
embedded/*.exe
embedded/**/.pio/

# Wokwi distributor outputs (regenerated by embedded/wokwi/prepare_projects.py
# from embedded/*.hpp + wokwi/common/sketch.ino; diagram.json stays tracked).
embedded/wokwi/esp32/hvac_pid_controller.hpp
embedded/wokwi/esp32/generated_policy.hpp
embedded/wokwi/esp32/sketch.ino
embedded/wokwi/stm32f103/hvac_pid_controller.hpp
embedded/wokwi/stm32f103/generated_policy.hpp
embedded/wokwi/stm32f103/sketch.ino

# Superseded experiment runs removed in dedup P1 (see experiments/manifests/archive_map.csv).
# History retained under tag pre-dedup-a3d8fba. Keep the audited review_v3 evidence instead.
outputs_adaptive_trial/
outputs_adaptive_final/
outputs_adaptive_final_v2/
outputs_review/
outputs_review_v2/
outputs_review_final/
outputs_review_v3_quick*/
outputs_llm_matrix_v2/
outputs_llm_agent/
outputs_llm_agent_live/
outputs_llm_agent_live_max/
outputs_llm_agent_real/
outputs/*
!outputs/README.md

# Learning-manual QA derivatives. The final DOCX remains tracked.
outputs_review_v3/learning_document/*.pdf
outputs_review_v3/learning_document/a11y_audit.json
outputs_review_v3/learning_document/rendered_*/
outputs_review_v3/learning_document/figures/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local API credentials (DASHSCOPE_API_KEY etc.); .env.example is the template.
.env

# md2docx formula render cache (regenerated on every conversion)
reports/figures/equations/

# local edit backups and Word lock files
reports/分报告/.bak_*/
reports/分报告/~$*
