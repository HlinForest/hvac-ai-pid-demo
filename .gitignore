# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Local OpenModelica runtime and temporary artifact-tool workspaces
modelica_runtime/
tmp/
tmp_submission/

# Generated inspection payloads: the actual Excel/PPT deliverables are retained.
outputs/**/*.inspect.ndjson
outputs_embedded_demo/*.inspect.ndjson

# OpenModelica C build intermediates; retain the response CSV used by validation.
outputs/modelica/*
!outputs/modelica/PrecisionCabinetCooling_res.csv

# Rendered slide previews duplicate the actual PowerPoint deliverable.
outputs/submission_package/slides_preview_v2/
outputs/submission_package/slides_rendered/

# Local document QA renders and audit JSON; final DOCX files remain tracked.
outputs/docx_qa/
outputs/documents/*_a11y.json

# Native testbench binaries are rebuilt from the supplied C++ source.
embedded/*.exe
embedded/**/.pio/

# Superseded experiment runs. Keep the audited final v2 evidence instead.
outputs_adaptive_trial/
outputs_adaptive_final/
outputs_review/
outputs_review_v2/
outputs_review_final/

# Learning-manual QA derivatives. The final DOCX remains tracked.
outputs_adaptive_final_v2/learning_document/*.pdf
outputs_adaptive_final_v2/learning_document/a11y_audit.json
outputs_adaptive_final_v2/learning_document/rendered_*/
outputs_adaptive_final_v2/learning_document/figures/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
